# Copy to .env.local only if you need to change a default. Never put secrets here.
DATABASE_DRIVER=pglite
PGLITE_DIR=.data/pglite
# Optional: your own email for the local owner (defaults to a fictional address).
# OWNER_EMAIL=you@example.com
# Lead Finder: your Google Places API (New) key. Put the real value in .env.local only, never here.
# GOOGLE_PLACES_API_KEY=
# Demo/tests only: use recorded Places responses and fixture websites instead of the internet.
# PLACES_TRANSPORT=fixtures
# WEB_TRANSPORT=fixtures
